<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DiceRollGame.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DiceRollGame"
    xmlns:views="clr-namespace:DiceRollGame.Views"
    Title="DiceRollGame">

    <TabBar>
        <Tab Title="Kockadobás">
            <ShellContent
                Route="DicePage"
                ContentTemplate="{DataTemplate views:DicePage}" />
        </Tab>
        <Tab Title="Játékosok">
            <ShellContent
                Route="PlayersPage"
                ContentTemplate="{DataTemplate views:PlayersPage}" />
        </Tab>
    </TabBar>

</Shell>
